# 默认按文本处理，Git 自动判断二进制文件
* text=auto

# Java / Maven：跨平台统一使用 LF，避免 CRLF 导致的全文件 diff
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.json text eol=lf

# Windows 批处理脚本需要 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 前端
*.vue text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# 二进制文件：不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
*.traineddata binary

# 语言统计排除，避免第三方文件影响仓库语言构成
package-lock.json linguist-generated
*.traineddata linguist-vendored
