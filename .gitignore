# ============================================================
#  AI 医疗助手 (ai-medical) - Git 忽略规则
# ============================================================

# ---------- 构建产物 ----------
target/
build/
out/
*.class
*.jar
*.war
*.ear

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 前端 ----------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
node_modules/
dist/
*.local

# ---------- IDE ----------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# VS Code（保留推荐的插件配置）
.vscode/*
!.vscode/extensions.json

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 敏感信息（切勿提交） ----------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
application-local.properties
application-local.yml
application-secret.properties

# ---------- 运行时输出 ----------
output/
tmp/
temp/

# ---------- 大体积二进制资源 ----------
# Tesseract OCR 语言训练数据：chi_sim 约 42MB、eng 约 22MB。
# 二者可从官方仓库稳定下载，且接近 GitHub 单文件 100MB 的限制，
# 因此不纳入版本控制。获取方式见 README.md 与 docs/TESSDATA.md。
#
# 使用无路径前缀的全局模式，确保匹配任意层级下的同名文件。
*.traineddata
*.traineddata.gz
