# ============================================================
#  AI 医疗助手 - 环境变量模板
#  用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#      Linux/macOS : cp .env.example .env
#      Windows     : copy .env.example .env
#
#  注意：Spring Boot 不会自动读取 .env 文件。请将下面的变量
#        导出为系统环境变量，或在 IDE 的运行配置中设置。
# ============================================================

# ---------- 大模型：阿里云百炼 DashScope（必填） ----------
# 申请地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
# 用于：qwen-plus 对话模型 + text-embedding-v3 向量化模型
DASH_SCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 向量数据库：Pinecone（必填） ----------
# 申请地址：https://app.pinecone.io/  →  API Keys
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------- 联网搜索：SerpApi（仅联网搜索工具需要） ----------
# 申请地址：https://serpapi.com/manage-api-key
GOOGLE_SEARCH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- MySQL（预约挂号数据） ----------
# 建表脚本：sql/schema.sql
MYSQL_URL=jdbc:mysql://localhost:3306/medical?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---------- MongoDB（会话记忆持久化） ----------
MONGODB_URI=mongodb://localhost:27017/chat_memory_db

# ---------- PDF 工具输出目录（可选） ----------
# 默认为项目工作目录下的 ./output/pdf
PDF_OUTPUT_DIR=./output/pdf
